---
import { PROJECTS } from "../../data/projects";
import ProjectCard from "../ui/ProjectCard.astro";
---

<section id="projects" class="section-block section-block--tinted">
    <div class="container-wide">
        <header class="section-head">
            <p class="section-eyebrow">Projects</p>
            <h2 class="title-lg">プロジェクト</h2>
            <p class="section-lead">
                カードを選ぶと、課題・取り組み・成果を表示します。
            </p>
        </header>

        <div class="project-grid">
            {PROJECTS.map((project) => <ProjectCard project={project} />)}
        </div>
    </div>

    <!-- 項目は固定。全プロジェクトが同じ枠を同じ順番で埋める -->
    <dialog id="project-dialog" class="project-dialog">
        <div class="project-dialog-inner">
            <button
                type="button"
                class="btn-icon project-dialog-close"
                id="project-dialog-close"
                aria-label="閉じる"
            >
                ×
            </button>

            <p class="project-dialog-category" id="project-dialog-category"></p>
            <h3 class="project-dialog-title" id="project-dialog-title"></h3>

            <dl class="project-dialog-meta">
                <div class="project-dialog-meta-row">
                    <dt>所属</dt>
                    <dd id="project-dialog-org"></dd>
                </div>
                <div class="project-dialog-meta-row">
                    <dt>期間</dt>
                    <dd id="project-dialog-period"></dd>
                </div>
                <div class="project-dialog-meta-row">
                    <dt>担当</dt>
                    <dd id="project-dialog-role"></dd>
                </div>
            </dl>

            <section class="project-dialog-section">
                <h4 class="project-dialog-subhead">概要</h4>
                <p class="project-dialog-text" id="project-dialog-summary"></p>
            </section>

            <section class="project-dialog-section">
                <h4 class="project-dialog-subhead">課題</h4>
                <p class="project-dialog-text" id="project-dialog-challenge"></p>
            </section>

            <section class="project-dialog-section">
                <h4 class="project-dialog-subhead">取り組み</h4>
                <ol class="project-dialog-approach" id="project-dialog-approach"></ol>
            </section>

            <section class="project-dialog-section">
                <h4 class="project-dialog-subhead">成果</h4>
                <p class="project-dialog-text" id="project-dialog-result"></p>
            </section>

            <section class="project-dialog-section">
                <h4 class="project-dialog-subhead">使用技術</h4>
                <div class="project-dialog-tags" id="project-dialog-tags"></div>
            </section>

            <section class="project-dialog-section">
                <h4 class="project-dialog-subhead">リポジトリ</h4>
                <a
                    href="#"
                    id="project-dialog-link"
                    class="link project-dialog-link"
                    target="_blank"
                    rel="noreferrer"
                >
                    GitHubで見る →
                </a>
                <p class="project-dialog-text" id="project-dialog-no-link">
                    公開していません。
                </p>
            </section>
        </div>
    </dialog>
</section>

<script is:inline>
    function initProjectModal() {
        const dialog = document.getElementById("project-dialog");
        if (!(dialog instanceof HTMLDialogElement)) return;

        const el = (id) => document.getElementById(`project-dialog-${id}`);
        const categoryEl = el("category");
        const titleEl = el("title");
        const orgEl = el("org");
        const periodEl = el("period");
        const roleEl = el("role");
        const summaryEl = el("summary");
        const challengeEl = el("challenge");
        const approachEl = el("approach");
        const resultEl = el("result");
        const tagsEl = el("tags");
        const linkEl = el("link");
        const noLinkEl = el("no-link");
        const closeBtn = el("close");

        document.querySelectorAll(".project-card").forEach((card) => {
            card.addEventListener("click", () => {
                const raw = card.getAttribute("data-project");
                if (!raw) return;
                const project = JSON.parse(raw);

                categoryEl.textContent = project.category;
                titleEl.textContent = project.title;
                orgEl.textContent = project.org;
                periodEl.textContent = project.period;
                roleEl.textContent = project.role;
                summaryEl.textContent = project.summary;
                challengeEl.textContent = project.challenge;
                resultEl.textContent = project.result;

                approachEl.innerHTML = "";
                project.approach.forEach((item) => {
                    const li = document.createElement("li");
                    li.textContent = item;
                    approachEl.appendChild(li);
                });

                tagsEl.innerHTML = "";
                project.tech.forEach((tech) => {
                    const span = document.createElement("span");
                    span.className = "tag";
                    span.textContent = `#${tech}`;
                    tagsEl.appendChild(span);
                });

                // リポジトリの有無だけは可変。項目自体は常に出す
                const hasRepo = Boolean(project.repoUrl);
                if (hasRepo) linkEl.href = project.repoUrl;
                linkEl.style.display = hasRepo ? "" : "none";
                noLinkEl.style.display = hasRepo ? "none" : "";

                // 前回開いた位置が残らないよう先頭へ戻す
                dialog.scrollTop = 0;
                dialog.showModal();
            });
        });

        closeBtn?.addEventListener("click", () => dialog.close());
        dialog.addEventListener("click", (event) => {
            if (event.target === dialog) dialog.close();
        });
    }

    document.addEventListener("astro:page-load", initProjectModal);
</script>
