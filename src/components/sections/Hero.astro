---
import { PROFILE } from "../../data/profile";
---

<section id="top" class="hero">
    <div class="hero-inner">
        <div class="hero-text">
            <p class="hero-reading">{PROFILE.reading}</p>
            <h1 class="hero-name">{PROFILE.name}</h1>
            <p class="hero-tagline">{PROFILE.tagline}</p>
            <p class="hero-lead">{PROFILE.aspiration}</p>
            <div class="hero-actions">
                <a href="#projects" class="btn btn-primary">プロジェクトを見る</a>
                <a href="#contact" class="btn">連絡する</a>
            </div>
        </div>
        <img
            class="hero-portrait"
            src={`/${PROFILE.avatar}`}
            alt={`${PROFILE.name}のプロフィール写真`}
            width="210"
            height="210"
            loading="eager"
        />
    </div>

    <p class="hero-scroll">Scroll</p>
</section>
