---
import { SKILL_CATEGORIES, SKILL_LEVELS, AI_STANCE_NOTE } from "../../data/skills";
---

<section id="skills" class="section-block">
    <div class="container-narrow">
        <header class="section-head">
            <p class="section-eyebrow">Skills</p>
            <h2 class="title-lg">スキル</h2>
        </header>

        {
            SKILL_CATEGORIES.map((category) => {
                // 書ける→使える→使い方がわかる→使ったことがある の順に並べる
                const sortedItems = [...category.items].sort(
                    (a, b) => SKILL_LEVELS.indexOf(b.level) - SKILL_LEVELS.indexOf(a.level)
                );
                return (
                    <div class="skill-category">
                        <div class="block-head">
                            <h3 class="block-title">{category.category}</h3>
                            <span class="block-rule" />
                        </div>
                        <ul class="skill-list">
                            {sortedItems.map((item) => {
                                const levelIndex = SKILL_LEVELS.indexOf(item.level) + 1;
                                return (
                                    <li class={`skill-chip skill-lv${levelIndex}`} title={item.level}>
                                        {item.name}
                                    </li>
                                );
                            })}
                        </ul>
                    </div>
                );
            })
        }

        <div class="note-box">
            <p class="note-box-title">{AI_STANCE_NOTE.title}</p>
            <p class="note-box-body">{AI_STANCE_NOTE.body}</p>
        </div>
    </div>
</section>
