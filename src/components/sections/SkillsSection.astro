---
import {
    SKILL_CATEGORIES,
    SKILL_LEGEND,
    SKILL_LEVEL_RANK,
} from "../../data/skills";
---

<section id="skills" class="section-block">
    <div class="container-narrow">
        <header class="section-head">
            <p class="section-eyebrow">Skills</p>
            <h2 class="title-lg">スキル</h2>
        </header>

        <ul class="skill-legend">
            {
                // SKILL_LEGEND は高い順に定義済み
                SKILL_LEGEND.map((level) => (
                    <li class={`skill-legend-item skill-lv${level.rank}`}>
                        <span class="skill-legend-bar" />
                        {level.label}
                    </li>
                ))
            }
        </ul>

        {
            SKILL_CATEGORIES.map((category) => {
                // ランクの高い順に並べる
                const sortedItems = [...category.items].sort(
                    (a, b) => SKILL_LEVEL_RANK[b.level] - SKILL_LEVEL_RANK[a.level]
                );
                return (
                    <div class="skill-category">
                        <div class="block-head">
                            <h3 class="block-title">{category.category}</h3>
                            <span class="block-rule" />
                        </div>
                        <ul class="skill-list">
                            {sortedItems.map((item) => (
                                <li
                                    class={`skill-chip skill-lv${SKILL_LEVEL_RANK[item.level]}`}
                                    title={item.level}
                                >
                                    {item.name}
                                </li>
                            ))}
                        </ul>
                    </div>
                );
            })
        }
    </div>
</section>
