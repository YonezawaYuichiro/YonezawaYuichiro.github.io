---
import { PROFILE } from "../../data/profile";

// 経歴ブロックは定義をまとめて回す（マークアップの重複を避ける）
const timelineBlocks = [
    { title: "学歴", items: PROFILE.education, full: false },
    { title: "インターン", items: PROFILE.internships, full: false },
    { title: "職歴", items: PROFILE.workHistory, full: false },
    { title: "受賞", items: PROFILE.awards, full: false },
    { title: "直近の学習", items: PROFILE.recentLearning, full: true },
];

const facts = [
    { label: "生年月日", value: PROFILE.birthDate },
    { label: "出身", value: PROFILE.birthPlace },
    { label: "拠点", value: PROFILE.base },
];
---

<section id="about" class="section-block section-block--tinted">
    <div class="container-narrow">
        <header class="section-head">
            <p class="section-eyebrow">About</p>
            <h2 class="title-lg">自己紹介</h2>
        </header>

        <div class="about-lead measure">
            {PROFILE.intro.map((paragraph) => <p>{paragraph}</p>)}
        </div>

        <ul class="about-facts">
            {
                facts.map((fact) => (
                    <li class="about-fact">
                        <span class="about-fact-label">{fact.label}</span>
                        <span>{fact.value}</span>
                    </li>
                ))
            }
        </ul>

        <div class="timeline-grid">
            {
                timelineBlocks.map((block) => (
                    <div class={block.full ? "timeline-full" : undefined}>
                        <div class="block-head">
                            <h3 class="block-title">{block.title}</h3>
                            <span class="block-rule" />
                        </div>
                        <ul class="timeline">
                            {block.items.map((item) => (
                                <li class="timeline-item">
                                    <p class="timeline-label">{item.label}</p>
                                    <p class="timeline-detail">{item.detail}</p>
                                </li>
                            ))}
                        </ul>
                    </div>
                ))
            }
        </div>

        <div class="cert-block">
            <div class="block-head">
                <h3 class="block-title">保有資格・免許</h3>
                <span class="block-rule"></span>
                <span class="body-xs">{PROFILE.certifications.length}件／取得順</span>
            </div>
            <ul class="cert-timeline">
                {
                    PROFILE.certifications.map((item) => (
                        <li class="cert-timeline-item">
                            <span class="cert-timeline-date">{item.date}</span>
                            <span class="cert-timeline-label">{item.label}</span>
                            {item.note && <span class="cert-timeline-note">{item.note}</span>}
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>
</section>
