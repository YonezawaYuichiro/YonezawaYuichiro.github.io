---
import { SKILL_CATEGORIES, SKILL_LEVELS, AI_STANCE_NOTE } from "../../data/skills";
---

<section id="skills" class="section-block">
    <div class="container-narrow">
        <p class="section-eyebrow">Skills</p>
        <h2 class="title-lg">スキル</h2>
        <p class="body mt-4">
            数値の自己採点ではなく、実際にできることを基準にした4段階の申告です。
        </p>

        <ul class="skill-legend">
            {
                SKILL_LEVELS.map((level, i) => (
                    <li class={`skill-legend-item skill-lv${i + 1}`}>
                        <span class="skill-legend-dot" />
                        {level}
                    </li>
                ))
            }
        </ul>

        <div class="mt-4">
            {
                SKILL_CATEGORIES.map((category) => (
                    <div class="skill-category">
                        <p class="skill-category-title">{category.category}</p>
                        <ul class="badge-list">
                            {category.items.map((item) => {
                                const levelIndex = SKILL_LEVELS.indexOf(item.level) + 1;
                                return (
                                    <li class={`badge-item skill-lv${levelIndex}`}>
                                        <span class="badge-item-name">{item.name}</span>
                                    </li>
                                );
                            })}
                        </ul>
                    </div>
                ))
            }
        </div>

        <div class="ai-stance-box">
            <p class="ai-stance-title">{AI_STANCE_NOTE.title}</p>
            <p class="ai-stance-body">{AI_STANCE_NOTE.body}</p>
        </div>
    </div>
</section>
