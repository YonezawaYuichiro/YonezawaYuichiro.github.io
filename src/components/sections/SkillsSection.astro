---
import { SKILL_CATEGORIES, AI_STANCE_NOTE } from "../../data/skills";
---

<section id="skills" class="section-block">
    <div class="container-narrow">
        <p class="section-eyebrow">Skills</p>
        <h2 class="title-lg">スキル</h2>
        <p class="body mt-4">
            数値の自己採点ではなく、実際にできることを基準にした申告です（使ったことがある ／ 使い方がわかる ／ 使える ／ 書ける）。
        </p>

        <div class="mt-4">
            {
                SKILL_CATEGORIES.map((category) => (
                    <div class="skill-category">
                        <p class="skill-category-title">{category.category}</p>
                        <ul class="badge-list">
                            {category.items.map((item) => (
                                <li class="badge-item">
                                    <span class="badge-item-name">{item.name}</span>
                                    <span class="badge-item-meta">{item.level}</span>
                                </li>
                            ))}
                        </ul>
                    </div>
                ))
            }
        </div>

        <div class="ai-stance-box">
            <p class="ai-stance-title">{AI_STANCE_NOTE.title}</p>
            <p class="ai-stance-body">{AI_STANCE_NOTE.body}</p>
        </div>
    </div>
</section>
